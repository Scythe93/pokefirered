script TRAINER_Forest_Lass1{
    trainerbattle_single(TRAINER_RLASS1, RLass_Intro, RLass_Outro)
    msgbox(PostBattle_RLass, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

text RLass_Intro{
    "Rainforests are delicate ecosystems"
}

text RLass_Outro{
    "Best of luck!"
}

text PostBattle_RLass{
    "Best of luck!"
}


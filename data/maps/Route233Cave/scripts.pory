}

script Groudon1{
    lockall
    msgbox("...")
    waitmessage
    closemessage
    playmoncry(SPECIES_GROUDON, CRY_MODE_NORMAL)
    waitmoncry
    setwildbattle(SPECIES_GROUDON, 65, ITEM_NONE)
    dowildbattle 
    removeobject(1)
    setflag(FLAG_0x0C6)
    releaseall
    end

}

script Warning1{
    lockall
    msgbox(format("What's that Triangle?"))
    msgbox(format("It has the reflection of a Groudon!"))
    msgbox(format("Better SAVE the game before advancing!"))
    waitmessage
    closemessage
    releaseall
}
mapscripts BillsLake2_MapScripts{

}

script FallsSign1{
    lockall
    msgbox("Jahova Falls")
    closemessage
    releaseall
    end
}

script Jahova_hiker1{
    trainerbattle_single(TRAINER_JAHOVA_HIKER1, Jhike1_Intro, Jhike1_Outro)
    msgbox(PostBattle_Jhike1, MSGBOX_AUTOCLOSE)
    waitmessage
    end
}

text Jhike1_Outro{
    "Largest waterfall in the region!"
    }

text Jhike1_Intro{
    "Feel the mist from the waterfall?"
}

text PostBattle_Jhike1{
    "maybe I should train harder..."
}

